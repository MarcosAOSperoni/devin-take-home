generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: viewer | agent | approver | admin
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String
  createdAt DateTime @default(now())

  refunds     Refund[]
  kycAssigned KycCase[] @relation("KycAssignee")
  kycNotes    KycNote[]
  accessRequests AccessRequest[]
}

// status: approved | pending_approval | rejected
model Refund {
  id            String   @id @default(cuid())
  orderId       String
  customerName  String
  amountCents   Int
  reason        String
  status        String
  requestedById String
  createdAt     DateTime @default(now())

  requestedBy User @relation(fields: [requestedById], references: [id])

  @@index([status])
}

// status: pending | in_review | escalated | approved | rejected (approved/rejected are final)
// riskLevel: low | medium | high. ssn and dateOfBirth (YYYY-MM-DD) are PII: mask in loaders.
model KycCase {
  id               String   @id @default(cuid())
  reference        String   @unique
  customerName     String
  dateOfBirth      String
  country          String
  documentType     String
  riskLevel        String
  ssn              String
  status           String
  assigneeId       String?
  escalatedById    String?
  escalationReason String?
  decidedById      String?
  decisionReason   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignee User?     @relation("KycAssignee", fields: [assigneeId], references: [id])
  notes    KycNote[]

  @@index([status])
  @@index([riskLevel])
  @@index([assigneeId])
}

model KycNote {
  id        String   @id @default(cuid())
  caseId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  case   KycCase @relation(fields: [caseId], references: [id])
  author User    @relation(fields: [authorId], references: [id])

  @@index([caseId])
}

// decision: approved | rejected
model Approval {
  id            String    @id @default(cuid())
  resourceType  String
  resourceId    String
  requestedById String
  decidedById   String?
  decision      String?
  reason        String?
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  @@index([resourceType, resourceId])
}

// Append-only. outcome: success | denied. before/after are redacted JSON strings.
model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String?
  actorName    String?
  action       String
  resourceType String
  resourceId   String?
  before       String?
  after        String?
  outcome      String
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId])
}

// system: payments-db | kyc-db | admin-console. durationHours: 1 | 4 | 24.
// status: pending | approved | denied | revoked (denied/revoked final). "expired" is never stored:
// it is an approved request whose expiresAt <= now, computed on read.
model AccessRequest {
  id             String    @id @default(cuid())
  requesterId    String
  system         String
  reason         String
  durationHours  Int
  status         String
  approvalId     String?
  decidedById    String?
  decisionReason String?
  decidedAt      DateTime?
  expiresAt      DateTime?
  revokedById    String?
  revokeReason   String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  requester User @relation(fields: [requesterId], references: [id])

  @@index([status])
  @@index([requesterId])
}
